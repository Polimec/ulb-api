{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polkadot-cloud-sse",
  "main": "src/index.ts",
	"compatibility_date": "2025-04-14",
  "assets": {
    "directory": "public"
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "MyDurableObject"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Listener",
        "name": "LISTENER"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}